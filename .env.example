# The twin's settings. The easy way to fill this in: npm run setup
# (it copies this file to .env, asks a few questions and tests your key).
# .env stays on this computer and is never shared. Restart the twin after editing it.

# Brain: openai (GPT) or claude. Only the chosen one's key is needed.
# With no key the twin runs in demo mode and repeats what you said instead of thinking.
BRAIN=openai

# GPT: API key from https://platform.openai.com/api-keys (billed separately from ChatGPT).
# This key also powers recall by meaning and the default backup model, even with BRAIN=claude.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# none or low keeps spoken replies quick; medium or high think longer.
OPENAI_REASONING_EFFORT=low

# Claude: API key from https://platform.claude.com (Settings, API keys).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low keeps spoken replies quick; medium or high think longer before answering.
CLAUDE_EFFORT=low

# Backup model: answers when the main model fails (an outage, a rate limit, a wrong
# model name) or hasn't started answering after FALLBACK_AFTER_SECONDS. Blank uses
# gpt-5.4-mini. A name starting with "claude" uses Claude. "none" turns it off.
FALLBACK_MODEL=
FALLBACK_AFTER_SECONDS=20

# Voice: leave these blank to use the Mac's built-in voice (Mac only).
# For a cloned voice, the person records and consents at https://elevenlabs.io; the
# voice ID is on the voice's page there.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Mac voice name from `say -v '?'`. Blank uses the system voice.
MAC_VOICE=

# Name shown at the top of the page.
TWIN_NAME=Twin
# The address is http://localhost:PORT. Change it if another program already uses 4747.
PORT=4747

# Advanced: other folders or files, relative to this folder. Blank uses the defaults.
# Persona notes (persona/), memory (memory/), behaviour rules (rules.md), House settings (house.json).
PERSONA_DIR=
MEMORY_DIR=
RULES_FILE=
HOUSE_FILE=
