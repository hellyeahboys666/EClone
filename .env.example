# The clone's settings. The easy way to fill this in: npm run setup
# (it copies this file to .env, asks a few questions and tests your key).
# .env stays on this computer and is never shared. Restart the clone after editing it.

# Brain: openai (GPT, API key), claude (Claude, API key), or chatgpt (GPT on your ChatGPT
# plan instead of API credits, through OpenAI's Codex tool: npm install -g @openai/codex,
# then codex login and choose Sign in with ChatGPT. Slower: about 5 seconds a reply).
# With no key (or sign-in) the clone runs in demo mode and repeats what you said.
BRAIN=openai

# GPT: API key from https://platform.openai.com/api-keys (billed separately from ChatGPT).
# This key also powers recall by meaning and the default backup model, even with BRAIN=claude.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# none or low keeps spoken replies quick; medium or high think longer.
OPENAI_REASONING_EFFORT=low

# Claude: API key from https://platform.claude.com (Settings, API keys).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low keeps spoken replies quick; medium or high think longer before answering.
CLAUDE_EFFORT=low

# ChatGPT sign-in (BRAIN=chatgpt): Codex's model and effort. Only Codex's own models work
# with a ChatGPT sign-in. CODEX_BASE_URL=default uses Codex's own settings instead of
# talking to ChatGPT directly. CODEX_BIN is the path to codex if it isn't found.
CODEX_MODEL=gpt-6-sol
CODEX_EFFORT=low
CODEX_BASE_URL=
CODEX_BIN=

# Backup model: answers when the main model fails (an outage, a rate limit, a wrong
# model name) or hasn't started answering after FALLBACK_AFTER_SECONDS. Blank uses
# gpt-5.4-mini. A name starting with "claude" uses Claude. "none" turns it off.
FALLBACK_MODEL=
FALLBACK_AFTER_SECONDS=20

# Whether the clone may cut you off while you're still typing or talking, if what
# you've said so far really gets to it (it uses the backup model, which is quick).
# "no" turns it off.
CLONE_INTERRUPTS=yes

# Voice: easiest is the Voice chip on the clone's page, which fills these in for you
# (paste the key, pick a voice from your account, try it, save). Blank uses the Mac's
# built-in voice (Mac only). For a cloned voice, the person records and agrees to it
# themselves at https://elevenlabs.io.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
# eleven_flash_v2_5 (fastest), eleven_turbo_v2_5, eleven_multilingual_v2, eleven_v3 (most expressive)
ELEVENLABS_MODEL=eleven_flash_v2_5
# Mac voice name from `say -v '?'`. Blank uses the system voice.
MAC_VOICE=

# Name shown at the top of the page.
CLONE_NAME=Clone
# The address is http://localhost:PORT. Change it if another program already uses 4747.
PORT=4747

# Advanced: other folders or files, relative to this folder. Blank uses the defaults.
# Persona notes (persona/), memory (memory/), behaviour rules (rules.md), House settings (house.json).
PERSONA_DIR=
MEMORY_DIR=
RULES_FILE=
HOUSE_FILE=
# Pictures and 3D models you upload for the house (house-assets/). Private.
HOUSE_ASSETS_DIR=
# The weekly schedule (schedule.json), edited on the Mind page.
SCHEDULE_FILE=
